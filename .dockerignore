.git
.gitignore

# Local secrets and runtime state must never enter a Docker build context.
.env
.env.*
!.env.example
config.json
config.local*.json
.idea
.venv
__pycache__
*.pyc
*.pyo
*.pyd
logs
runtime
storage/
data/
images/
image_thumbnails/
*.db
*.sqlite
*.sqlite3
*.pem
*.key
*.p12
*.pfx
standalone
test
tests
docs/*.md
# Scripts are host/deployment tooling. The application image has no need for
# them, so exclude the whole directory rather than maintaining a denylist.
scripts/

web
web-vue/dist
web-vue/node_modules
web_dist

assets
README.md
